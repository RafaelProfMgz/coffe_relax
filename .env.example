# Domínio público do site — usado em canonical, sitemap, robots, Open Graph e JSON-LD.
# Sem barra no final. Em produção: https://coffe.lotmhub.com.br (subdomínio do lotmhub.com.br).
NEXT_PUBLIC_SITE_URL=https://coffe.lotmhub.com.br

# E-mail que recebe o formulário de contato e aparece nas páginas legais (opcional).
NEXT_PUBLIC_CONTACT_EMAIL=rafaelprojmgz@gmail.com

# Formulário de contato (/contato): envio pelo Resend. Sem a chave, a página mostra só o e-mail direto.
# O remetente precisa ser de um domínio verificado no Resend.
RESEND_API_KEY=
CONTACT_FROM="coffe to relax <contato@coffe.lotmhub.com.br>"
